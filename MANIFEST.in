include CHANGELOG.md
include LICENSE
include README.md
include mkdocs.yml
# setuptools ships tests/test*.py; three of them import tests/helpers.py, and
# tests/test_deploy_firebase_hosting.py reads the deploy script and its config.
include tests/helpers.py
include .firebaserc
include firebase.json
include scripts/deploy_firebase_hosting.py
recursive-include assets *
recursive-include docs *
prune build
prune dist
prune site
global-exclude __pycache__
global-exclude *.py[cod]
global-exclude .DS_Store
